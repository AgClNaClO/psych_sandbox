# ChatECNU chat models. Fill in your own API key; role models remain explicit.
MODEL_API_KEY=
MODEL_BASE_URL=https://chat.ecnu.edu.cn/open/api/v1
CLIENT_MODEL=ecnu-max
COUNSELOR_MODEL=ecnu-max
SUPERVISOR_MODEL=ecnu-max
# Used by the E.7/E.8/E.9 extraction, merge, and session-summary API calls.
SUMMARY_MODEL=ecnu-max
MODEL_STRUCTURED_OUTPUT=auto
MODEL_TIMEOUT_SECONDS=180
MODEL_MAX_TOKENS=8192

# Embeddings are used only when the expanded atomic count exceeds
# skill_selection.vector_threshold in runtime.yaml.
# With the official ChatECNU HTTPS chat endpoint above, leave these blank to use:
# EMBEDDING_BASE_URL=https://chat.ecnu.edu.cn/open/api/v1
# EMBEDDING_MODEL=ecnu-embedding-small
# EMBEDDING_API_KEY=<same as MODEL_API_KEY>
# Explicit embedding values take priority. Model/key defaults apply only when
# both endpoints are official ChatECNU (HTTPS, port 443, /open/api/v1).
# For any other endpoint, set all three embedding values independently;
# the chat key is never inherited across hosts, ports or API paths.
# ChatECNU requests contain at most 64 texts and 8192 total characters.
# A single text longer than 8192 characters raises an error; it is not truncated.
EMBEDDING_MODEL=
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_TIMEOUT_SECONDS=60
