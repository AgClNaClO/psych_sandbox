# Python caches and generated package metadata
__pycache__/
*.py[cod]
*.egg-info/

# Coverage reports (keep coverage configuration files)
.coverage
.coverage.*
coverage.xml
htmlcov/

# JavaScript dependencies and local build caches
node_modules/
npm-debug.log*
# workbench/frontend_dist is intentionally versioned for the bundled Web UI.

# Operating-system metadata
.DS_Store
Thumbs.db
Desktop.ini

# Editor-local settings and temporary files
.vscode/*
!.vscode/extensions.json

# Machine-local Python environment and credentials
.venv/
.env
.env.*
!.env.example

# Downloaded datasets and generated run artifacts
runs/*
!runs/README.md
!runs/tests/
!runs/runtime/
runs/tests/*
!runs/tests/README.md
runs/runtime/*
!runs/runtime/README.md
data/processed/
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm
*.sqlite3-journal
*.log
